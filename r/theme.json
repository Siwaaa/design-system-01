{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "theme",
  "title": "limeui Theme",
  "description": "Тема limeui: primary #d9da26 (лайм), нейтральная тёплая серая шкала, именованный радиус (pill/lg/md/sm), без теней в покое. cssVars генерируются из registry/limeui/theme/theme.css скриптом scripts/build-registry.mjs.",
  "dependencies": [
    "@fontsource-variable/geist",
    "@fontsource-variable/geist-mono"
  ],
  "cssVars": {
    "theme": {
      "font-sans": "\"Geist Variable\", ui-sans-serif, system-ui, -apple-system, sans-serif",
      "font-mono": "\"Geist Mono Variable\", ui-monospace, SFMono-Regular, Menlo, monospace",
      "radius-pill": "999px",
      "radius-lg": "20px",
      "radius-md": "14px",
      "radius-sm": "10px"
    },
    "light": {
      "background": "#f7f7f5",
      "foreground": "#0c0c0b",
      "foreground-subtle": "#9c9c95",
      "card": "#ffffff",
      "card-foreground": "#0c0c0b",
      "popover": "#ffffff",
      "popover-foreground": "#0c0c0b",
      "primary": "#d9da26",
      "primary-foreground": "#0c0c0b",
      "primary-soft": "#f4f7b9",
      "secondary": "#f1f1ee",
      "secondary-foreground": "#0c0c0b",
      "muted": "#f3f3ef",
      "muted-foreground": "#6b6b66",
      "accent": "#e5e5e1",
      "accent-foreground": "#0c0c0b",
      "success": "#057e21",
      "success-vivid": "#7cef83",
      "success-soft": "color-mix(in oklab, var(--success-vivid) 18%, transparent)",
      "warning": "#7e6900",
      "warning-vivid": "#f4ce23",
      "warning-soft": "color-mix(in oklab, var(--warning-vivid) 18%, transparent)",
      "destructive": "#c01323",
      "destructive-foreground": "#ffffff",
      "destructive-vivid": "#ed4042",
      "destructive-soft": "color-mix(in oklab, var(--destructive-vivid) 18%, transparent)",
      "neutral": "#6c6d60",
      "neutral-vivid": "#80817a",
      "border": "#e1e1de",
      "border-strong": "#d0cfcc",
      "border-mute": "#eaeae6",
      "input": "#e1e1de",
      "ring": "#0c0c0b",
      "sidebar": "#ffffff",
      "sidebar-foreground": "#0c0c0b",
      "sidebar-border": "#e7e7e2",
      "sidebar-accent": "#f1f1ee",
      "sidebar-accent-foreground": "#0c0c0b",
      "sidebar-primary": "#0c0c0b",
      "sidebar-primary-foreground": "#ffffff",
      "sidebar-ring": "#0c0c0b",
      "chart-1": "#d9da26",
      "chart-2": "#118226",
      "chart-3": "#6b6b66",
      "chart-4": "#0c0c0b",
      "chart-5": "#9c9c95"
    },
    "dark": {
      "background": "#0c0c0b",
      "foreground": "#f7f7f5",
      "foreground-subtle": "#6b6b66",
      "card": "#161615",
      "card-foreground": "#f7f7f5",
      "popover": "#161615",
      "popover-foreground": "#f7f7f5",
      "primary": "#d9da26",
      "primary-foreground": "#0c0c0b",
      "primary-soft": "#2e2f14",
      "secondary": "#252523",
      "secondary-foreground": "#f7f7f5",
      "muted": "#232321",
      "muted-foreground": "#9c9c95",
      "accent": "#2e2e2c",
      "accent-foreground": "#f7f7f5",
      "success": "#54b85b",
      "success-vivid": "#7cef83",
      "success-soft": "color-mix(in oklab, var(--success-vivid) 16%, transparent)",
      "warning": "#b89d2b",
      "warning-vivid": "#f4ce23",
      "warning-soft": "color-mix(in oklab, var(--warning-vivid) 16%, transparent)",
      "destructive": "#ff635f",
      "destructive-foreground": "#0c0c0b",
      "destructive-vivid": "#ed4042",
      "destructive-soft": "color-mix(in oklab, var(--destructive-vivid) 20%, transparent)",
      "neutral": "#9fa092",
      "neutral-vivid": "#80817a",
      "border": "#30302f",
      "border-strong": "#424241",
      "border-mute": "#1e1e1d",
      "input": "#30302f",
      "ring": "#f7f7f5",
      "sidebar": "#111110",
      "sidebar-foreground": "#f7f7f5",
      "sidebar-border": "#2c2c2a",
      "sidebar-accent": "#232322",
      "sidebar-accent-foreground": "#f7f7f5",
      "sidebar-primary": "#f7f7f5",
      "sidebar-primary-foreground": "#0c0c0b",
      "sidebar-ring": "#f7f7f5",
      "chart-1": "#d9da26",
      "chart-2": "#54b85b",
      "chart-3": "#9c9c95",
      "chart-4": "#f7f7f5",
      "chart-5": "#6b6b66"
    }
  },
  "css": {
    "@import \"@fontsource-variable/geist\"": {},
    "@import \"@fontsource-variable/geist-mono\"": {}
  },
  "docs": "Шрифты Geist и Geist Mono установлены как npm-зависимости. Если после установки текст рендерится системным шрифтом — проверьте, что в главном CSS есть строки `@import \"@fontsource-variable/geist\";` и `@import \"@fontsource-variable/geist-mono\";` сразу после `@import \"tailwindcss\";`.",
  "type": "registry:theme"
}